# Vantage LMS Environment Variables Example

# Application
PORT=4000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vantage_lms

# Redis Cache & Leaderboard
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth JWT Secret
JWT_SECRET=vantage_super_secret_jwt_key_2026
JWT_EXPIRATION=7d
